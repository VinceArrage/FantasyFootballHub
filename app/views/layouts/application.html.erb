<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Fantasy Football Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Fantasy Football Hub">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <header class="bg-emerald-900 text-white">
      <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center gap-4">
        <%= link_to "🏈 War Room", root_path, class: "font-bold text-lg" %>
        <nav class="flex flex-wrap gap-3 text-sm">
          <% League.order(:name).each do |league| %>
            <%= link_to league.name, league_path(league), class: "hover:underline" %>
          <% end %>
        </nav>
        <% if Account.current %>
          <%= button_to "Sync now", sync_now_path, class: "ml-auto text-sm bg-emerald-700 hover:bg-emerald-600 rounded px-3 py-1" %>
        <% end %>
      </div>
    </header>

    <% if Account.current %>
      <%= turbo_stream_from :sync_status %>
      <%= render "shared/sync_stamps" %>
    <% end %>

    <main class="max-w-6xl mx-auto px-4 py-6">
      <% flash.each do |type, message| %>
        <div class="mb-4 rounded px-4 py-2 <%= type == "alert" ? "bg-red-100 text-red-800" : "bg-emerald-100 text-emerald-900" %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
