<% content_for :title, @league.name %>
<h1 class="text-2xl font-bold mb-3"><%= @league.name %></h1>
<%= render "leagues/tabs", league: @league %>
<%= turbo_stream_from @league, :scoreboard %>
<%= turbo_stream_from @league, :standings %>
<div class="mb-4"><%= render "leagues/scoreboard", league: @league %></div>
<div class="grid gap-4 md:grid-cols-2">
  <%= render "leagues/standings", league: @league %>
  <%= render "leagues/roster", team: @my_team %>
</div>
