<% content_for :title, "Trade log · #{@league.name}" %>
<h1 class="text-2xl font-bold mb-3"><%= @league.name %></h1>
<%= render "leagues/tabs", league: @league %>
<section class="bg-white rounded-lg shadow p-4">
  <h2 class="font-bold mb-2">Every trade, and who's winning it</h2>
  <% if @trades.empty? %>
    <p class="text-sm text-gray-500">No trades yet this season.</p>
  <% else %>
    <ul class="divide-y">
      <% @trades.each do |trade| %>
        <% card = Trades::Scorecard.new(trade) %>
        <% winner = card.winner %>
        <li class="py-3 text-sm">
          <div class="text-gray-500 mb-1">Week <%= trade.week %> · <%= trade.executed_at&.to_date&.to_fs(:long) %></div>
          <div class="grid md:grid-cols-2 gap-2">
            <% card.call.each do |side| %>
              <div class="rounded p-2 <%= side.team == winner ? "bg-emerald-50 ring-1 ring-emerald-300" : "bg-gray-50" %>">
                <div class="font-semibold"><%= side.team.display_name %> <%= "🏆" if side.team == winner %></div>
                <div>Got: <%= side.received.map(&:full_name).to_sentence.presence || "—" %>
                  <% if side.picks.any? %> + <%= side.picks.size %> pick(s) (not valued)<% end %></div>
                <div class="text-gray-600"><%= points(side.points_since) %> pts scored for them since</div>
              </div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
