<% my_team = league.my_team %>
<% rank = league.teams.standings.index(my_team)&.succ %>
<section class="bg-white rounded-lg shadow p-4">
  <div class="flex items-baseline justify-between">
    <h2 class="font-bold"><%= link_to league.name, league_path(league), class: "hover:underline" %></h2>
    <% if my_team %>
      <span class="text-sm text-gray-600"><%= my_team.record %> · #<%= rank %> of <%= league.teams.size %></span>
    <% end %>
  </div>
  <%= turbo_stream_from league, :injuries %>
  <h3 class="mt-3 mb-1 text-xs uppercase tracking-wide text-gray-500">Injuries</h3>
  <%= render "leagues/injury_flags", league: %>
  <% waivers = Recommendations::WaiverRanker.new(league, values: Valuation::PlayerValues.new(league, week:), trending:).call(limit: 3) %>
  <h3 class="mt-3 mb-1 text-xs uppercase tracking-wide text-gray-500">Top waiver adds</h3>
  <% if waivers.empty? %>
    <p class="text-sm text-gray-500">Nothing worth a claim.</p>
  <% else %>
    <ol class="divide-y"><%= render partial: "leagues/waiver_row", collection: waivers, as: :waiver %></ol>
  <% end %>
</section>
