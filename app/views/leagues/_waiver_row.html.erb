<li class="py-2 flex flex-wrap items-baseline justify-between gap-2 text-sm">
  <span>
    <strong><%= waiver[:player].full_name %></strong>
    <span class="text-gray-500"><%= waiver[:player].position %> <%= waiver[:player].nfl_team %></span>
    <% if waiver[:trending_rank] %><span class="ml-1 rounded bg-amber-100 text-amber-800 px-1 text-xs">trending #<%= waiver[:trending_rank] %></span><% end %>
  </span>
  <span class="text-gray-600">
    <span class="font-semibold text-emerald-700">+<%= points(waiver[:gain]) %></span> pts rest of season
    <% if waiver[:drop] %> · drop <%= waiver[:drop].full_name %><% end %>
  </span>
</li>
