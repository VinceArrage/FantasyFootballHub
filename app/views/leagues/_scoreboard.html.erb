<% week ||= Nfl::Calendar.week %>
<% mine = league.matchups.find_by(week:, team: league.my_team) %>
<% opp = mine&.opponent %>
<div id="<%= dom_id(league, :scoreboard) %>" class="flex items-center justify-between rounded bg-gray-100 px-3 py-2 text-sm">
  <% if mine && opp %>
    <span class="<%= "font-bold" if mine.points >= opp.points %>">Me <%= points(mine.points) %></span>
    <span class="text-gray-500">wk <%= week %></span>
    <span class="<%= "font-bold" if opp.points > mine.points %>"><%= points(opp.points) %> <%= opp.team.display_name %></span>
  <% else %>
    <span class="text-gray-500">No matchup this week.</span>
  <% end %>
</div>
