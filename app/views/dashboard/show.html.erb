<% content_for :title, "War Room" %>
<% if @leagues.empty? %>
  <p class="text-gray-600">No leagues yet. The first sync usually takes under a minute.</p>
<% else %>
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% @leagues.each do |league| %>
      <%= render "leagues/card", league: %>
    <% end %>
  </div>

  <%= turbo_stream_from :injuries %>
  <section class="mt-6 bg-white rounded-lg shadow p-4">
    <h2 class="font-bold mb-2">Injury changes on my rosters</h2>
    <ul id="injury_feed" class="divide-y">
      <%= render partial: "injury_events/injury_event", collection: InjuryEvent.for_my_players.recent.includes(:player) %>
    </ul>
  </section>
<% end %>
