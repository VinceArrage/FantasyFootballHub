<% content_for :title, "Link Sleeper" %>
<div class="max-w-md mx-auto bg-white rounded-lg shadow p-6">
  <h1 class="text-xl font-bold mb-2">Link your Sleeper account</h1>
  <p class="text-sm text-gray-600 mb-4">Read-only. The app only reads public league data.</p>
  <%= form_with url: setup_path, method: :post, class: "flex gap-2" do |f| %>
    <%= f.text_field :username, value: @username, placeholder: "Sleeper username", required: true,
                     class: "flex-1 border rounded px-3 py-2" %>
    <%= f.submit "Link & sync", class: "bg-emerald-700 text-white rounded px-4 py-2 cursor-pointer" %>
  <% end %>
</div>
